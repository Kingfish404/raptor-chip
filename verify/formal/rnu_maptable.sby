[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 5

[engines]
smtbmc

[script]
plugin -i slang
read_slang --single-unit -DFORMAL formal_rnu_maptable.sv rapt_rnu_maptable.sv
prep -top formal_rnu_maptable

[files]
formal_rnu_maptable.sv
rapt_rnu_maptable.sv ../../hdl/frontend/rapt_rnu_maptable.sv
rapt.svh ../../hdl/include/rapt.svh
rapt_config.svh ../../hdl/configs/formal/rapt_config.svh
rapt_sva.svh ../../hdl/include/rapt_sva.svh
rapt_rnu_internal_if.svh ../../hdl/include/rapt_rnu_internal_if.svh
