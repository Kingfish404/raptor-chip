[tasks]
prove2 prove ways2
prove4 prove ways4
prove8 prove ways8
cover2 cover ways2
cover4 cover ways4
cover8 cover ways8

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 18

[engines]
smtbmc

[script]
plugin -i slang
ways2: read_slang --single-unit -DFORMAL -GWays=2 formal_plru.sv rapt_cache_plru.sv --top formal_plru
ways4: read_slang --single-unit -DFORMAL -GWays=4 formal_plru.sv rapt_cache_plru.sv --top formal_plru
ways8: read_slang --single-unit -DFORMAL -GWays=8 formal_plru.sv rapt_cache_plru.sv --top formal_plru
prep -top formal_plru

[files]
formal_plru.sv
rapt_cache_plru.sv ../../hdl/memory/rapt_cache_plru.sv
