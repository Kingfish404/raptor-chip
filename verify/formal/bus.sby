[tasks]
basic bmc
basic: default

[options]
bmc:
mode bmc
depth 8

[engines]
smtbmc

[script]
plugin -i slang
read_slang --single-unit -DFORMAL -DYSYX_XLEN=32 -DYSYX_REG_SIZE=32 -DYSYX_REG_LEN=5 formal_bus.sv ysyx_pack.sv
prep -top formal_bus

[files]
formal_bus.sv
ysyx_pack.sv ./../../nsim/build/ysyx_pack.sv
