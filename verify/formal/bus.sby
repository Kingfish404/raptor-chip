[tasks]
basic bmc
basic: default

[options]
bmc:
mode bmc
depth 8

[engines]
smtbmc

[script]
plugin -i slang
read_slang --single-unit -DFORMAL -DRAPT_XLEN=32 -DRAPT_REG_SIZE=32 -DRAPT_REG_LEN=5 formal_bus.sv rapt_pack.sv
prep -top formal_bus

[files]
formal_bus.sv
rapt_pack.sv ./../../sim/build/default/rapt_pack.sv
