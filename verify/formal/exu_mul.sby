[tasks]
basic bmc
basic: default

[options]
bmc:
mode bmc
depth 3

[engines]
smtbmc

[script]
plugin -i slang
read_slang --single-unit -DFORMAL -DRAPT_XLEN=32 -DRAPT_REG_SIZE=32 -DRAPT_REG_LEN=5 -DRAPT_ALU_MUL___=5'b11000 -DRAPT_ALU_MULH__=5'b11001 -DRAPT_ALU_MULHSU=5'b11010 -DRAPT_ALU_MULHU_=5'b11011 -DRAPT_ALU_DIV___=5'b11100 -DRAPT_ALU_DIVU__=5'b11101 -DRAPT_ALU_REM___=5'b11110 -DRAPT_ALU_REMU__=5'b11111 formal_exu_mul.sv rapt_pack.sv
prep -top formal_exu_mul

[files]
formal_exu_mul.sv
rapt_pack.sv ./../../sim/build/default/rapt_pack.sv
