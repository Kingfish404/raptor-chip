# Deny all, whitelist sources
*
!*/

# Source & config files
!Makefile
!Kconfig
!README.md
!.gitignore
!*.[cSh]
!*.cc
!*.cpp
!*.mk
!configs/*
!scripts/*.sh
!*.sv
!gsim/*.json

# SRAM macro integration sources (nsim/sram/**)
!sram/scripts/*.py
!sram/configs/*.py
!sram/test/*.py
!sram/test/*.sh
!sram/wrappers/*.v

# Build artifacts
build/
tmp/
/obj_dir
/include/config
/include/generated
