{
  "_comment": [
    "ChampSim-style DSE config for raptor_se.py.",
    "Aligned to configs/default/rapt_config.svh and rtl_sv/frontend/branch_predictor/* as of 2026-05-17.",
    "Default BPU mirrors the RTL TAGE flavor (RAPT_BPU_DIRP_TAGE): 256-entry bimodal base + 3 tagged tables of 128 entries (tag widths 7/7/8, histories 8/16/64, 3-bit signed counter, 1-bit useful).",
    "Unspecified keys keep the .svh-derived/default simulator value.",
    "Examples: --set ooo_cpu.0.rob_size=32 --set L1I.ways=2 --set ooo_cpu.0.branch_predictor=gshare.",
    "Advanced BP capacity knobs live under branch_predictor.{btb,pht,ras,tage,loop,statistical_corrector,perceptron}.",
    "BP families: local, bimodal, bimode, gshare, tournament, tage, ltage, tage_sc_l_8kb, tage_sc_l_64kb, mpp_8kb, mpp_64kb, mpp_tage_8kb, mpp_tage_64kb.",
    "Run from nsim/gsim: make coremark JSON_CONFIG=dse-config.json"
  ],
  "executable_name": "raptor-gem5-se",
  "block_size": 64,
  "page_size": 4096,
  "heartbeat_frequency": 10000000,
  "num_cores": 1,
  "ooo_cpu": [
    {
      "frequency": 1000,
      "ifetch_buffer_size": 64,
      "register_file_size": 128,
      "rob_size": 64,
      "lq_size": 16,
      "sq_size": 16,
      "fetch_width": 2,
      "decode_width": 2,
      "rename_width": 2,
      "dispatch_width": 2,
      "execute_width": 2,
      "writeback_width": 2,
      "retire_width": 2,
      "squash_width": 2,
      "scheduler_size": 16,
      "m_fast": true,
      "branch_predictor": "local",
      "btb": "simple_btb"
    }
  ],
  "L1I": {
    "sets": 32,
    "ways": 2,
    "rq_size": 1,
    "wq_size": 1,
    "pq_size": 0,
    "mshr_size": 1,
    "latency": 1,
    "max_tag_check": 1,
    "max_fill": 1,
    "prefetch_as_load": false,
    "virtual_prefetch": false,
    "prefetcher": "no"
  },
  "L1D": {
    "sets": 16,
    "ways": 2,
    "rq_size": 1,
    "wq_size": 1,
    "pq_size": 0,
    "mshr_size": 1,
    "latency": 1,
    "max_tag_check": 1,
    "max_fill": 1,
    "prefetch_as_load": false,
    "virtual_prefetch": false,
    "prefetcher": "no"
  },
  "BTB": {
    "entries": 128,
    "ways": 2,
    "tag_bits": 7,
    "type": "simple_btb"
  },
  "PHT": {
    "entries": 256,
    "counter_bits": 2
  },
  "RAS": {
    "entries": 4,
    "enabled": true
  },
  "indirect_branch_predictor": {
    "enabled": false,
    "sets": 256,
    "ways": 2,
    "tag_bits": 16,
    "path_length": 3,
    "ghr_bits": 13,
    "hash_ghr": true,
    "hash_targets": true
  },
  "branch_predictor": {
    "_comment": "Defaults mirror rtl_sv/frontend/branch_predictor/rapt_bpu_tage.sv: 3 tagged tables of 128 entries with tag widths 7/7/8 and history lengths 8/16/64 over a 256-entry 2-bit bimodal base. ~5.4 Kbit hardware TAGE budget. hist_buffer_size is the gem5 speculative-history rollback buffer, not hardware state.",
    "kind": "tage",
    "btb": {
      "entries": 128,
      "ways": 2,
      "tag_bits": 7
    },
    "pht": {
      "entries": 256,
      "counter_bits": 2
    },
    "ras": {
      "entries": 4,
      "enabled": true
    },
    "capacity": {
      "budget_bits": 5504
    },
    "tage": {
      "n_history_tables": 3,
      "min_history": 8,
      "max_history": 64,
      "tag_table_tag_widths": [
        0,
        7,
        7,
        8
      ],
      "log_table_sizes": [
        8,
        7,
        7,
        7
      ],
      "log_ratio_bimodal_hyst_entries": 0,
      "counter_bits": 3,
      "u_bits": 1,
      "hist_buffer_size": 2048,
      "path_history_bits": 8,
      "log_u_reset_period": 12,
      "num_use_alt_on_na": 1,
      "initial_t_counter_value": 2048,
      "use_alt_on_na_bits": 4,
      "max_allocations": 1
    },
    "loop": {
      "log_size": 3,
      "age_bits": 4,
      "confidence_bits": 2,
      "tag_bits": 10,
      "iter_bits": 10,
      "assoc_log": 1,
      "initial_loop_age": 7,
      "initial_loop_iter": 0
    },
    "statistical_corrector": {
      "num_entries_first_local_histories": 64,
      "log_bias": 7,
      "log_size_up": 5
    },
    "perceptron": {
      "budget_bits": 12288,
      "num_local_histories": 48,
      "num_filter_entries": 0,
      "local_history_length": 11
    }
  },
  "L2C": {
    "enabled": false,
    "sets": 512,
    "ways": 8,
    "mshr_size": 16,
    "latency": 8
  },
  "physical_memory": {
    "size": "512MiB",
    "latency": "30ns"
  },
  "virtual_memory": {
    "pte_page_size": 4096,
    "num_levels": 2
  },
  "simulation": {
    "cpu": "o3",
    "rv64": false,
    "storeset": false,
    "with_l2": false
  }
}