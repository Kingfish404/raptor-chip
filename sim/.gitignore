# Deny all, whitelist sources
*
!*/

# Source & config files
!Makefile
!Kconfig
!README.md
!.gitignore
!*.[cSh]
!*.cc
!*.cpp
!tools/*.py
!*.mk
!configs/*
!scripts/*.sh
!scripts/configure.py
!scripts/build_cache.py
!scripts/paddr_config.py
!scripts/sta.py
!tests/test_npc_axi_protocol.py
!tests/test_npc_write_outstanding.py
!*.sv
!*.svh
!gsim/*.json
!ysyxsoc/setup.py

# SRAM macro integration sources (sim/sram/**)
!sram/scripts/*.py
!sram/configs/*.py
!sram/configs/*.py.in
!sram/test/*.py
!sram/test/*.sh
!sram/wrappers/*.v

# Build artifacts
build/
tmp/
_tmp_*
/obj_dir
/include/config
/include/generated
!scripts/eval-fpga.py
!tools/fpga_eval_summary.py
