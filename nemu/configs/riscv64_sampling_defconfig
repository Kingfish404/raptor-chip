# Deterministic single-hart CPU/RAM sampling; no network, disk or RNG device.
CONFIG_ISA_riscv=y
CONFIG_RV64=y
CONFIG_RV_F=y
CONFIG_RV_D=y
CONFIG_RV_SVADE=y
CONFIG_RV_ASID_BITS=9
CONFIG_RV_PMPADDR_BITS=30
CONFIG_RV_PC_BITS=40
CONFIG_RV_PMP_GRANULARITY_LOG2=12
# CONFIG_RV_MCOUNTINHIBIT is not set
CONFIG_TARGET_NATIVE_ELF=y
# CONFIG_DEBUG is not set
# CONFIG_TRACE is not set
# CONFIG_DIFFTEST is not set
CONFIG_ROM=y
CONFIG_ROM_DTB=y
CONFIG_ROM_DTB_PATH="./src/memory/rom/spike-rv64gc-nemu.dtb"
CONFIG_MBASE=0x80000000
CONFIG_MSIZE=0x80000000
CONFIG_PMEM_MALLOC=y
CONFIG_RAPTOR_PMEM_2G=y
CONFIG_DEVICE=y
CONFIG_HAS_SERIAL=y
CONFIG_SERIAL_INPUT_FIFO=y
CONFIG_SERIAL_MMIO=0x000003f8
CONFIG_SERIAL_MMIO_US16550=0x10000000
CONFIG_SERIAL_PLIC_IRQ=10
CONFIG_HAS_TIMER=y
CONFIG_RTC_MMIO=0x00000048
CONFIG_RTC_MMIO_CLINT=0x02000000
CONFIG_PLIC_MMIO=0x0c000000
CONFIG_HAS_FINISHER=y
CONFIG_FINISHER_MMIO=0x00100000
# CONFIG_HAS_KEYBOARD is not set
# CONFIG_HAS_VGA is not set
# CONFIG_HAS_AUDIO is not set
# CONFIG_HAS_DISK is not set
# CONFIG_HAS_NET is not set
# CONFIG_HAS_RNG is not set
# CONFIG_HAS_SDCARD is not set
CONFIG_TIMER_CYCLE=y
CONFIG_RT_CHECK=y
CONFIG_RAPTOR_MEMORY_MAP=y
