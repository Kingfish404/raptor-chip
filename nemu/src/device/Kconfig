menuconfig DEVICE
  depends on !TARGET_SHARE
  bool "Devices"
  default y
  help
    Provide device support for NEMU.

if DEVICE

config HAS_PORT_IO
  bool
  default y if ISA_x86
  default n

config DTRACE
  bool "Enable device tracer"
  default n

menuconfig HAS_SERIAL
  bool "Enable serial"
  default y

if HAS_SERIAL
config SERIAL_PORT
  depends on HAS_PORT_IO
  hex "Port address of the serial controller"
  default 0x3f8

config SERIAL_MMIO
  hex "MMIO address of the serial controller"
  default 0x000003f8

config SERIAL_INPUT_FIFO
  bool "Enable input FIFO with /tmp/nemu.serial"
  default n

config SERIAL_MMIO_US16550
  hex "MMIO address of the serial controller (US16550)"
  default 0x10000000

config SERIAL_PLIC_IRQ
  int "PLIC interrupt source ID for the ns16550 UART"
  default 1
  help
    PLIC source ID raised by the ns16550 model. Must match the
    `interrupts = <N>` cell in the bundled DTB used by the guest
    (see nemu/src/memory/rom/spike-rv*ima*.dts). Linux derives the
    handler from the DTB, so a mismatch silently drops UART RX IRQs.
    Bare-metal/tinyos workloads that poll LSR.DR are unaffected, but
    avoid colliding with VIRTIO_BLK_PLIC_IRQ.

endif # HAS_SERIAL

menuconfig HAS_TIMER
  bool "Enable timer"
  default y

if HAS_TIMER
config RTC_PORT
  depends on HAS_PORT_IO
  hex "Port address of the timer"
  default 0x48

config RTC_MMIO
  hex "MMIO address of the timer"
  default 0x00000048

config RTC_MMIO_CLINT
  hex "MMIO address of the timer (CLINT)"
  default 0x02000000
endif # HAS_TIMER


config PLIC_MMIO
  hex "MMIO address of the PLIC"
  default 0x0c000000

menuconfig HAS_FINISHER
  bool "Enable finisher (sifive,test / syscon-poweroff)"
  default y

if HAS_FINISHER
config FINISHER_MMIO
  hex "MMIO address of the finisher"
  default 0x00100000
endif # HAS_FINISHER

menuconfig HAS_KEYBOARD
  bool "Enable keyboard"
  default y

if HAS_KEYBOARD
config I8042_DATA_PORT
  depends on HAS_PORT_IO
  hex "Port address of the keyboard controller"
  default 0x60

config I8042_DATA_MMIO
  hex "MMIO address of the keyboard controller"
  default 0x00000060
endif # HAS_KEYBOARD

menuconfig HAS_VGA
  bool "Enable VGA"
  default y

if HAS_VGA
config FB_ADDR__
  hex "Physical address of the VGA frame buffer"
  default 0x01000000

config VGA_CTL_PORT
  depends on HAS_PORT_IO
  hex "Port address of the VGA controller"
  default 0x100

config VGA_CTL_MMIO
  hex "MMIO address of the VGA controller"
  default 0x00000100

config VGA_SHOW_SCREEN
  bool "Enable SDL SCREEN"
  default y

choice
  prompt "Screen Size"
  default VGA_SIZE_400x300
config VGA_SIZE_400x300
  bool "400 x 300"
config VGA_SIZE_800x600
  bool "800 x 600"
endchoice
endif # HAS_VGA

if !TARGET_AM
menuconfig HAS_AUDIO
  bool "Enable audio"
  default y

if HAS_AUDIO
config SB_ADDR
  hex "Physical address of the audio stream buffer"
  default 0x01200000

config SB_SIZE
  hex "Size of the audio stream buffer"
  default 0x10000

config AUDIO_CTL_PORT
  depends on HAS_PORT_IO
  hex "Port address of the audio controller"
  default 0x200

config AUDIO_CTL_MMIO
  hex "MMIO address of the audio controller"
  default 0x00000200
endif # HAS_AUDIO

menuconfig HAS_DISK
  bool "Enable disk"
  default y

if HAS_DISK
config DISK_CTL_PORT
  depends on HAS_PORT_IO
  hex "Port address of the disk controller"
  default 0x300

config DISK_CTL_MMIO
  hex "MMIO address of the disk controller"
  default 0x00000300

config DISK_IMG_PATH
  string "The path of disk image"
  default ""
endif # HAS_DISK

menuconfig HAS_NET
  bool "Enable virtio network with user-mode NAT"
  depends on !TARGET_AM
  default n
  help
    Provide a virtio-mmio network adapter backed by libslirp. The guest gets
    an address from the built-in DHCP server and can reach the host network
    without root privileges, a TAP device, or host-side bridge setup.

if HAS_NET
config NET_MMIO
  hex "MMIO address of the virtio network adapter"
  default 0x10002000

config NET_PLIC_IRQ
  int "PLIC interrupt source ID for the virtio network adapter"
  default 2
  help
    Must match the interrupts cell of the virtio,mmio node in the guest DTB.
endif # HAS_NET

menuconfig HAS_RNG
  bool "Enable virtio random number generator"
  depends on !TARGET_AM
  default n
  help
    Provide a virtio-mmio entropy device backed by the host operating
    system's cryptographically secure random number generator.

if HAS_RNG
config RNG_MMIO
  hex "MMIO address of the virtio random number generator"
  default 0x10003000

config RNG_PLIC_IRQ
  int "PLIC interrupt source ID for the virtio random number generator"
  default 3
  help
    Must match the interrupts cell of the virtio,mmio RNG node in the guest
    DTB and must not collide with another emulated device.
endif # HAS_RNG

menuconfig HAS_SDCARD
  bool "Enable sdcard"
  default n

if HAS_SDCARD
config SDCARD_CTL_MMIO
  hex "MMIO address of the sdcard controller"
  default 0x03000000

config SDCARD_IMG_PATH
  string "The path of sdcard image"
  default ""
endif # HAS_SDCARD
endif

endif # DEVICE
