CC = $(CMP_CC)
LD = $(CMP_CC)
AR = $(CMP_AR)
SIZE = $(CMP_SIZE)
OBJOUT = -o
COBJT = -c
CINCD = -I
CDEFN = -D
OEXT = .o
EXEOUT = -o
EXE = .elf
LIBTYPE = .a
LIBOUT =
CFLAGS = $(CMP_CFLAGS)
LINKER_FLAGS = $(CMP_LDFLAGS)
LINKER_LAST = -lm
LIBRARY = $(AR) rcs
LIBRARY_LAST =
WARNING_OPTIONS =
COMPILER_INCLUDES =
