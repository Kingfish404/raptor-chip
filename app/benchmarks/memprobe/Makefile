NAME = memprobe
SRCS = memprobe.c
MEMPROBE_STEPS ?= 65536
MEMPROBE_MATCH_BOARD ?= 0
MEMPROBE_QUICK ?= 0
MEMPROBE_STORE_ONLY ?= 0
CFLAGS += -DMEMPROBE_STEPS=$(MEMPROBE_STEPS) -DMEMPROBE_MATCH_BOARD=$(MEMPROBE_MATCH_BOARD) \
          -DMEMPROBE_QUICK=$(MEMPROBE_QUICK) -DMEMPROBE_STORE_ONLY=$(MEMPROBE_STORE_ONLY)
include $(AM_HOME)/Makefile
