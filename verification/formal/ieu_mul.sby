[tasks]
basic bmc rv32
rv64 bmc rv64
cover32 cover rv32
cover64 cover rv64

[options]
bmc: mode bmc
cover: mode cover
# Frame 3 is the first observable result after the initial reset.
depth 5
timeout 600

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
rv32: read_slang --single-unit -DFORMAL formal_ieu_mul.sv rapt_ieu_mul.sv
rv64: read_slang --single-unit -DFORMAL -DRAPT_RV64 formal_ieu_mul.sv rapt_ieu_mul.sv
prep -top formal_ieu_mul

[files]
formal_ieu_mul.sv
rapt_ieu_mul.sv ../../rtl/backend/ieu/rapt_ieu_mul.sv
rapt.svh ../../rtl/include/rapt.svh
rapt_fp_ops.svh ../../rtl/include/rapt_fp_ops.svh
rapt_config.svh ../../rtl/configs/default/rapt_config.svh
rapt_sva.svh ../../rtl/include/rapt_sva.svh
