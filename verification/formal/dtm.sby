[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 70

[engines]
smtbmc

[script]
plugin -i slang
read_slang --single-unit -DFORMAL formal_dtm.sv rapt_dtm.sv
prep -top formal_dtm

[files]
formal_dtm.sv
rapt_dtm.sv ../../rtl/perip/rapt_dtm.sv
rapt.svh ../../rtl/include/rapt.svh
rapt_fp_ops.svh ../../rtl/include/rapt_fp_ops.svh
rapt_config.svh ../../rtl/configs/formal/rapt_config.svh
rapt_sva.svh ../../rtl/include/rapt_sva.svh
