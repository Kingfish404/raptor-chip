[tasks]
rv32 prove full32
rv32_cover cover full32
rv64 prove full64
rv64_cover cover full64
rv32_simple prove simple32
rv32_simple_cover cover simple32
rv64_simple prove simple64
rv64_simple_cover cover simple64

[options]
prove: mode prove
cover: mode cover
depth 1
timeout 300

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
full32: read_slang --threads 1 --unroll-limit 20000 --single-unit -GXLEN=32 \
full32:   -GEnableRareOps=1 formal_ieu_alu.sv rapt_ieu_alu.sv
full64: read_slang --threads 1 --unroll-limit 20000 --single-unit -DRAPT_RV64 -GXLEN=64 \
full64:   -GEnableRareOps=1 formal_ieu_alu.sv rapt_ieu_alu.sv
simple32: read_slang --threads 1 --unroll-limit 20000 --single-unit -GXLEN=32 \
simple32:   -GEnableRareOps=0 formal_ieu_alu.sv rapt_ieu_alu.sv
simple64: read_slang --threads 1 --unroll-limit 20000 --single-unit -DRAPT_RV64 -GXLEN=64 \
simple64:   -GEnableRareOps=0 formal_ieu_alu.sv rapt_ieu_alu.sv
chformal -lower
prep -top formal_ieu_alu
check -assert
select -assert-none t:$assume t:$anyseq t:$anyconst A:blackbox=1
select -assert-count 1 t:$assert
select -assert-any t:$cover

[files]
formal_ieu_alu.sv
rapt_ieu_alu.sv ../../rtl/backend/ieu/rapt_ieu_alu.sv
rapt.svh ../../rtl/include/rapt.svh
rapt_fp_ops.svh ../../rtl/include/rapt_fp_ops.svh
rapt_config.svh ../../rtl/configs/formal/rapt_config.svh
rapt_sva.svh ../../rtl/include/rapt_sva.svh
