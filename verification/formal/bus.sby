[tasks]
basic bmc
basic: default

[options]
bmc:
mode bmc
depth 12

[engines]
smtbmc

[script]
plugin -i slang
read_slang --single-unit -DFORMAL -DRAPT_XLEN=32 -DRAPT_REG_SIZE=32 -DRAPT_REG_LEN=5 formal_bus.sv formal_bus_pack.sv
prep -top formal_bus

[files]
formal_bus.sv
formal_bus_pack.sv build/formal_bus_pack.sv
