[options]
bmc:
mode bmc
depth 30
--
prove:
mode prove
depth 10
--
cover:
mode cover
depth 32
--

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
rv64_smp2_l16:
read_slang --single-unit -DFORMAL -DRAPT_RV64 -I../../../../rtl/configs/small -I../../../../rtl/include -I../../../../rtl/include/dpic_mock -I../../../../rtl/include/npc -GNHARTS=2 ../../../../rtl/rapt_pkg.sv ../../../../rtl/uncore/rapt_coherence_hub.sv formal_coherence_hub.sv
--
rv64_smp2_l64:
read_slang --single-unit -DFORMAL -DRAPT_RV64 -I../../../../rtl/configs/default -I../../../../rtl/include -I../../../../rtl/include/dpic_mock -I../../../../rtl/include/npc -GNHARTS=2 ../../../../rtl/rapt_pkg.sv ../../../../rtl/uncore/rapt_coherence_hub.sv formal_coherence_hub.sv
--
rv64_smp4_l16:
read_slang --single-unit -DFORMAL -DRAPT_RV64 -I../../../../rtl/configs/small -I../../../../rtl/include -I../../../../rtl/include/dpic_mock -I../../../../rtl/include/npc -GNHARTS=4 -GCboFifoDepth=2 ../../../../rtl/rapt_pkg.sv ../../../../rtl/uncore/rapt_coherence_hub.sv formal_coherence_hub.sv
--
rv64_smp4_l64:
read_slang --single-unit -DFORMAL -DRAPT_RV64 -I../../../../rtl/configs/default -I../../../../rtl/include -I../../../../rtl/include/dpic_mock -I../../../../rtl/include/npc -GNHARTS=4 -GCboFifoDepth=2 ../../../../rtl/rapt_pkg.sv ../../../../rtl/uncore/rapt_coherence_hub.sv formal_coherence_hub.sv
--
rv32_smp2_l16:
read_slang --single-unit -DFORMAL -I../../../../rtl/configs/small -I../../../../rtl/include -I../../../../rtl/include/dpic_mock -I../../../../rtl/include/npc -GNHARTS=2 ../../../../rtl/rapt_pkg.sv ../../../../rtl/uncore/rapt_coherence_hub.sv formal_coherence_hub.sv
--
rv32_smp4_l64:
read_slang --single-unit -DFORMAL -I../../../../rtl/configs/default -I../../../../rtl/include -I../../../../rtl/include/dpic_mock -I../../../../rtl/include/npc -GNHARTS=4 -GCboFifoDepth=2 ../../../../rtl/rapt_pkg.sv ../../../../rtl/uncore/rapt_coherence_hub.sv formal_coherence_hub.sv
--
rv64_smp2_l16_l2o6:
