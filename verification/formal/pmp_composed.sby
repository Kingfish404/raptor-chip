[tasks]
ranges32
ranges64
selector32
selector64

[options]
mode prove
depth 1
timeout 300

[engines]
# The selector proofs (with range lemmas) need a bit-vector solver: bitwuzla
# closes them in seconds where the default yices exceeds the timeout.
ranges32: smtbmc
ranges64: smtbmc
selector32: smtbmc bitwuzla
selector64: smtbmc bitwuzla

[script]
plugin -i slang
ranges32: read_slang --single-unit --top formal_pmp -DRAPT_PMP_PROVE_RANGES pmp_formal_if.sv formal_pmp.sv rapt_pmp.sv
ranges64: read_slang --single-unit --top formal_pmp -DRAPT_RV64 -DRAPT_PMP_PROVE_RANGES pmp_formal_if.sv formal_pmp.sv rapt_pmp.sv
selector32: read_slang --single-unit --top formal_pmp -DRAPT_PMP_USE_RANGE_LEMMAS pmp_formal_if.sv formal_pmp.sv rapt_pmp.sv
selector64: read_slang --single-unit --top formal_pmp -DRAPT_RV64 -DRAPT_PMP_USE_RANGE_LEMMAS pmp_formal_if.sv formal_pmp.sv rapt_pmp.sv
prep -top formal_pmp

[files]
formal_pmp.sv
rapt_pmp.sv ../../rtl/memory/rapt_pmp.sv
rapt.svh ../../rtl/include/rapt.svh
rapt_config.svh ../../rtl/configs/formal/rapt_config.svh
rapt_sva.svh ../../rtl/include/rapt_sva.svh
rapt_fp_ops.svh ../../rtl/include/rapt_fp_ops.svh
pmp_formal_if.sv
