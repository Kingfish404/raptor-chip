[tasks]
rv32
rv64

[options]
mode prove
depth 1

[engines]
# yices did not return in 15 hours; bitwuzla proves RV32 in ~12 minutes.
smtbmc bitwuzla

[script]
rv32: plugin -i slang
rv32: read_slang --single-unit --top formal_pmp pmp_formal_if.sv formal_pmp.sv rapt_pmp.sv
rv64: plugin -i slang
rv64: read_slang --single-unit --top formal_pmp -DRAPT_RV64 pmp_formal_if.sv formal_pmp.sv rapt_pmp.sv
prep -top formal_pmp

[files]
formal_pmp.sv
rapt_pmp.sv ../../rtl/memory/mmu/rapt_pmp.sv
rapt.svh ../../rtl/include/rapt.svh
rapt_config.svh ../../rtl/configs/formal/rapt_config.svh
rapt_sva.svh ../../rtl/include/rapt_sva.svh
rapt_fp_ops.svh ../../rtl/include/rapt_fp_ops.svh
pmp_formal_if.sv
