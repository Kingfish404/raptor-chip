; Initial zero prefix, quotient and remainder satisfy Euclidean decomposition.
(set-option :produce-proofs true)
(set-logic QF_NIA)
(declare-const d Int)
(assert (> d 0))
(assert (not (and (= 0 (+ (* 0 d) 0)) (>= 0 0) (< 0 d))))
(check-sat)
(get-proof)

(reset)

; Sign correction gives truncation toward zero and a dividend-signed remainder.
; The RTL result encoder applies XLEN/W modular representation, including MIN/-1.
(set-option :produce-proofs true)
(set-logic QF_NIA)
(declare-const a Int)
(declare-const d Int)
(declare-const q Int)
(declare-const r Int)
(declare-const negative_a Bool)
(declare-const negative_b Bool)
(assert (and (>= a 0) (> d 0) (>= q 0) (>= r 0) (< r d)))
(assert (= a (+ (* q d) r)))
(define-fun signed_a () Int (ite negative_a (- a) a))
(define-fun signed_b () Int (ite negative_b (- d) d))
(define-fun signed_q () Int (ite (xor negative_a negative_b) (- q) q))
(define-fun signed_r () Int (ite negative_a (- r) r))
(assert (not (and (= signed_a (+ (* signed_q signed_b) signed_r))
                 (or (= signed_r 0) (= (> signed_r 0) (> signed_a 0))))
))
(check-sat)
(get-proof)

(reset)

; Canonical MSB-first division preserves prefix = quotient * divisor + remainder.
; This lemma is unbounded over integers. The RTL refinement separately proves
; bit consumption, nonnegative representations and absence of truncation.
(set-option :produce-proofs true)
(set-logic QF_NIA)
(declare-const p Int)
(declare-const q Int)
(declare-const r Int)
(declare-const d Int)
(declare-const bit Int)
(define-fun appended () Int (+ (* 2 r) bit))
(define-fun quotient_bit () Int (ite (>= appended d) 1 0))
(define-fun q_next () Int (+ (* 2 q) quotient_bit))
(define-fun r_next () Int (- appended (* quotient_bit d)))
(define-fun p_next () Int (+ (* 2 p) bit))
(assert (> d 0))
(assert (and (>= q 0) (>= r 0) (< r d) (>= p 0)))
(assert (or (= bit 0) (= bit 1)))
(assert (= p (+ (* q d) r)))
(assert (not (and (= p_next (+ (* q_next d) r_next))
                 (>= q_next 0) (>= r_next 0) (< r_next d)
                 (<= q_next p_next) (<= r_next p_next))))
(check-sat)
(get-proof)

(reset)

; A nonnegative Euclidean quotient/remainder pair for a positive divisor is unique.
(set-option :produce-proofs true)
(set-logic QF_NIA)
(declare-const a Int)
(declare-const d Int)
(declare-const q Int)
(declare-const r Int)
(declare-const other_q Int)
(declare-const other_r Int)
(assert (> d 0))
(assert (and (>= a 0) (>= q 0) (>= r 0) (< r d)))
(assert (and (>= other_q 0) (>= other_r 0) (< other_r d)))
(assert (= a (+ (* q d) r)))
(assert (= a (+ (* other_q d) other_r)))
(assert (or (distinct q other_q) (distinct r other_r)))
(check-sat)
(get-proof)
