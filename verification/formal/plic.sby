[tasks]
rv32
rv64
rv32_full
rv64_full
cover

[options]
rv32: mode prove
rv32: depth 4
rv64: mode prove
rv64: depth 4
rv32_full: mode prove
rv32_full: depth 4
rv64_full: mode prove
rv64_full: depth 4
cover: mode cover
cover: depth 16

[engines]
rv32: smtbmc --nopresat z3
rv64: smtbmc --nopresat z3
cover: smtbmc --nopresat z3
rv32_full: smtbmc --nopresat bitwuzla
rv64_full: smtbmc --nopresat bitwuzla

[script]
plugin -i slang
rv32: read_slang --single-unit -DFORMAL --top formal_plic -G XLEN=32 perip_formal_if.sv formal_plic.sv rapt_plic.sv
rv64: read_slang --single-unit -DFORMAL --top formal_plic -G XLEN=64 perip_formal_if.sv formal_plic.sv rapt_plic.sv
rv32_full: read_slang --single-unit -DFORMAL --top formal_plic -G XLEN=32 -G NDEV=31 perip_formal_if.sv formal_plic.sv rapt_plic.sv
rv64_full: read_slang --single-unit -DFORMAL --top formal_plic -G XLEN=64 -G NDEV=31 perip_formal_if.sv formal_plic.sv rapt_plic.sv
cover: read_slang --single-unit -DFORMAL --top formal_plic -G XLEN=32 perip_formal_if.sv formal_plic.sv rapt_plic.sv
prep -top formal_plic

[files]
perip_formal_if.sv
rapt_soc_if.svh
formal_plic.sv
rapt_plic.sv ../../rtl/perip/rapt_plic.sv
rapt.svh ../../rtl/include/rapt.svh
rapt_config.svh ../../rtl/configs/formal/rapt_config.svh
rapt_sva.svh ../../rtl/include/rapt_sva.svh
rapt_fp_ops.svh ../../rtl/include/rapt_fp_ops.svh
rapt_soc.svh ../../rtl/include/npc/rapt_soc.svh
