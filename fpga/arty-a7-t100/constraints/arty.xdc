# Derived from job/board/Arty-A7-100-Master.xdc; omitted JD/LED/UART pins
# checked against Digilent's public Arty-A7-100-Master.xdc (Rev D/E).
set_property -dict {PACKAGE_PIN E3 IOSTANDARD LVCMOS33} [get_ports clk100]
set_property -dict {PACKAGE_PIN D9 IOSTANDARD LVCMOS33} [get_ports {btn[0]}]
set_property -dict {PACKAGE_PIN C9 IOSTANDARD LVCMOS33} [get_ports {btn[1]}]
set_property -dict {PACKAGE_PIN A8 IOSTANDARD LVCMOS33} [get_ports boot_switch]
set_property -dict {PACKAGE_PIN H5 IOSTANDARD LVCMOS33} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN J5 IOSTANDARD LVCMOS33} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN T9 IOSTANDARD LVCMOS33} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN T10 IOSTANDARD LVCMOS33} [get_ports {led[3]}]
set_property -dict {PACKAGE_PIN N15 IOSTANDARD LVCMOS33} [get_ports uart_rx]
set_property -dict {PACKAGE_PIN T16 IOSTANDARD LVCMOS33} [get_ports uart_tx]

# SoC JA/JB -> board JC/JD. Numbers in the README are physical header pins.
set_property -dict {PACKAGE_PIN G13 IOSTANDARD LVCMOS33} [get_ports chip_sclk]
set_property -dict {PACKAGE_PIN B11 IOSTANDARD LVCMOS33} [get_ports chip_cs_n]
set_property -dict {PACKAGE_PIN A11 IOSTANDARD LVCMOS33} [get_ports {chip_dq[0]}]
set_property -dict {PACKAGE_PIN D12 IOSTANDARD LVCMOS33} [get_ports {chip_dq[1]}]
set_property -dict {PACKAGE_PIN D13 IOSTANDARD LVCMOS33} [get_ports {chip_dq[2]}]
set_property -dict {PACKAGE_PIN B18 IOSTANDARD LVCMOS33} [get_ports {chip_dq[3]}]
set_property -dict {PACKAGE_PIN A18 IOSTANDARD LVCMOS33} [get_ports {chip_dq[4]}]
set_property -dict {PACKAGE_PIN K16 IOSTANDARD LVCMOS33} [get_ports {chip_dq[5]}]
set_property -dict {PACKAGE_PIN E15 IOSTANDARD LVCMOS33} [get_ports {chip_dq[6]}]
set_property -dict {PACKAGE_PIN E16 IOSTANDARD LVCMOS33} [get_ports {chip_dq[7]}]
set_property -dict {PACKAGE_PIN U12 IOSTANDARD LVCMOS33} [get_ports board_sclk]
set_property -dict {PACKAGE_PIN V12 IOSTANDARD LVCMOS33} [get_ports board_cs_n]
set_property -dict {PACKAGE_PIN V10 IOSTANDARD LVCMOS33} [get_ports {board_dq[0]}]
set_property -dict {PACKAGE_PIN V11 IOSTANDARD LVCMOS33} [get_ports {board_dq[1]}]
set_property -dict {PACKAGE_PIN U14 IOSTANDARD LVCMOS33} [get_ports {board_dq[2]}]
set_property -dict {PACKAGE_PIN V14 IOSTANDARD LVCMOS33} [get_ports {board_dq[3]}]
set_property -dict {PACKAGE_PIN T13 IOSTANDARD LVCMOS33} [get_ports {board_dq[4]}]
set_property -dict {PACKAGE_PIN U13 IOSTANDARD LVCMOS33} [get_ports {board_dq[5]}]
set_property -dict {PACKAGE_PIN D4 IOSTANDARD LVCMOS33} [get_ports {board_dq[6]}]
set_property -dict {PACKAGE_PIN D3 IOSTANDARD LVCMOS33} [get_ports {board_dq[7]}]

# Standard Arduino/ChipKIT D13, D12, D11, D10 respectively.
set_property -dict {PACKAGE_PIN P17 IOSTANDARD LVCMOS33} [get_ports jtag_tck]
set_property -dict {PACKAGE_PIN R17 IOSTANDARD LVCMOS33} [get_ports jtag_tms]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33} [get_ports jtag_tdi]
set_property -dict {PACKAGE_PIN V17 IOSTANDARD LVCMOS33} [get_ports jtag_tdo]

# Existing external MT35X fixture. No on-board configuration-flash signals.
set_property -dict {PACKAGE_PIN V16 IOSTANDARD LVCMOS33} [get_ports flash_ck]
set_property -dict {PACKAGE_PIN R10 IOSTANDARD LVCMOS33} [get_ports flash_cs_n]
set_property -dict {PACKAGE_PIN U11 IOSTANDARD LVCMOS33} [get_ports flash_reset_n]
set_property -dict {PACKAGE_PIN M13 IOSTANDARD LVCMOS33} [get_ports flash_dqs]
set_property -dict {PACKAGE_PIN N16 IOSTANDARD LVCMOS33} [get_ports {flash_dq[7]}]
set_property -dict {PACKAGE_PIN N14 IOSTANDARD LVCMOS33} [get_ports {flash_dq[6]}]
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33} [get_ports {flash_dq[5]}]
set_property -dict {PACKAGE_PIN R18 IOSTANDARD LVCMOS33} [get_ports {flash_dq[4]}]
set_property -dict {PACKAGE_PIN T18 IOSTANDARD LVCMOS33} [get_ports {flash_dq[3]}]
set_property -dict {PACKAGE_PIN N17 IOSTANDARD LVCMOS33} [get_ports {flash_dq[2]}]
set_property -dict {PACKAGE_PIN R16 IOSTANDARD LVCMOS33} [get_ports {flash_dq[1]}]
set_property -dict {PACKAGE_PIN P18 IOSTANDARD LVCMOS33} [get_ports {flash_dq[0]}]
set_property PULLUP true [get_ports {flash_cs_n flash_reset_n}]
set_property PULLDOWN true [get_ports flash_dqs]
set_property PULLDOWN true [get_ports jtag_tck]
set_property PULLUP true [get_ports {jtag_tms jtag_tdi board_cs_n}]
set_property PULLDOWN true [get_ports {board_sclk chip_dq[*] board_dq[*]}]
set_property DRIVE 4 [get_ports -filter {DIRECTION != IN}]
set_property SLEW SLOW [get_ports -filter {DIRECTION != IN}]
create_clock -name ref100 -period 10.000 [get_ports clk100]

set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
