# FMC_C contacts are listed in docs/bringup.md. Set its adjustable supply to 1.8 V.
set_property PACKAGE_PIN P26 [get_ports clk100]
set_property PACKAGE_PIN AJ14 [get_ports cpu_resetn]
set_property PACKAGE_PIN AM11 [get_ports serial_rx]
set_property PACKAGE_PIN AN11 [get_ports serial_tx]
set_property PACKAGE_PIN G9 [get_ports external_clock]
set_property PACKAGE_PIN F18 [get_ports pad_clk]
set_property PACKAGE_PIN F17 [get_ports pad_reset_n]
set_property PACKAGE_PIN B15 [get_ports pad_irq]
set_property PACKAGE_PIN L19 [get_ports pad_xspi_sclk]
set_property PACKAGE_PIN D14 [get_ports pad_xspi_cs_n]
set_property PACKAGE_PIN B16 [get_ports {pad_xspi_dq[0]}]
set_property PACKAGE_PIN B17 [get_ports {pad_xspi_dq[1]}]
set_property PACKAGE_PIN A18 [get_ports {pad_xspi_dq[2]}]
set_property PACKAGE_PIN A19 [get_ports {pad_xspi_dq[3]}]
set_property PACKAGE_PIN D15 [get_ports {pad_xspi_dq[4]}]
set_property PACKAGE_PIN E15 [get_ports {pad_xspi_dq[5]}]
set_property PACKAGE_PIN L18 [get_ports {pad_xspi_dq[6]}]
set_property PACKAGE_PIN C14 [get_ports {pad_xspi_dq[7]}]
set_property PACKAGE_PIN A15 [get_ports pad_jtag_tck]
set_property PACKAGE_PIN E8 [get_ports pad_jtag_tms]
set_property PACKAGE_PIN E13 [get_ports pad_jtag_tdi]
set_property PACKAGE_PIN C12 [get_ports pad_jtag_tdo]
set_property PACKAGE_PIN B12 [get_ports pad_diag]
set_property IOSTANDARD LVCMOS18 [get_ports {clk100 cpu_resetn external_clock pad_*}]
set_property IOSTANDARD LVCMOS33 [get_ports {serial_rx serial_tx}]
set_property PULLTYPE PULLUP [get_ports cpu_resetn]
set_property SLEW SLOW [get_ports {pad_clk pad_reset_n pad_irq pad_jtag_* pad_xspi_dq[*]}]
set_property DRIVE 8 [get_ports {pad_clk pad_reset_n pad_irq pad_jtag_tck pad_jtag_tms}]
create_clock -name board -period 10 [get_ports clk100]
create_clock -name external -period 20 [get_ports external_clock]
set_clock_groups -asynchronous -group board -group external
# The UART and chip link are oversampled data. These are asynchronous pin paths.
set_false_path -from [get_ports {cpu_resetn serial_rx pad_xspi_sclk pad_xspi_cs_n}]
set_false_path -from [get_ports {pad_xspi_dq[*] pad_jtag_tdo pad_diag}]
set_false_path -to [get_ports {serial_tx pad_reset_n pad_irq pad_jtag_tck}]
set_false_path -to [get_ports {pad_jtag_tms pad_jtag_tdi pad_xspi_dq[*]}]
set_output_delay -clock board -max 5 [get_ports pad_clk]
set_output_delay -clock board -min 0 [get_ports pad_clk]
set_property CONFIG_VOLTAGE 1.8 [current_design]
set_property CFGBVS GND [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLDOWN [current_design]
