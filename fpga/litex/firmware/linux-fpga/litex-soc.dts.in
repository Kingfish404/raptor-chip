/dts-v1/;

/ {
    #address-cells = <1>;
    #size-cells = <1>;
    compatible = "raptor,litex-soc";
    model = "Raptor LiteX SoC on MLK-CU07-KU15P";

    aliases {
        serial0 = &liteuart0;
    };

    chosen {
        stdout-path = "/soc/serial@@UART_UNIT_ADDR@";
        bootargs = "@BOOTARGS@";
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        timebase-frequency = <@TIMEBASE@>;

        cpu@0 {
            device_type = "cpu";
            compatible = "riscv";
            riscv,isa = "@RISCV_ISA@";
            riscv,isa-base = "@RISCV_ISA_BASE@";
            riscv,isa-extensions = @RISCV_ISA_EXTENSIONS@;
            riscv,cbom-block-size = <@CBOM_BLOCK_SIZE@>;
            mmu-type = "riscv,@RISCV_MMU@";
            reg = <0>;

            cpu0_intc: interrupt-controller {
                #address-cells = <0>;
                #interrupt-cells = <1>;
                compatible = "riscv,cpu-intc";
                interrupt-controller;
            };
        };
    };

    soc {
        #address-cells = <1>;
        #size-cells = <1>;
        compatible = "simple-bus";
        ranges;

        clint@2000000 {
            compatible = "riscv,clint0";
            reg = <0x02000000 0x10000>;
            interrupts-extended = <&cpu0_intc 3>,
                                  <&cpu0_intc 7>;
        };

        plic: interrupt-controller@c000000 {
            compatible = "riscv,plic0";
            #address-cells = <0>;
            #interrupt-cells = <1>;
            interrupt-controller;
            reg = <0x0c000000 0x04000000>;
            riscv,ndev = <31>;
            interrupts-extended = <&cpu0_intc 11>,
                                  <&cpu0_intc 9>;
        };

        liteuart0: serial@@UART_UNIT_ADDR@ {
            compatible = "litex,liteuart";
            reg = <@UART_BASE@ 0x100>;
            interrupt-parent = <&plic>;
            interrupts = <1>;
            status = "okay";
        };
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 @MEM_SIZE@>;
    };
};