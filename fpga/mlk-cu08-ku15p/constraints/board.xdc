# CU08-KU15P pinout: matches fpga/litex/mlk_cu08_ku15p_platform.py.
# Board-specific physical constraints.
set_property PACKAGE_PIN P26 [get_ports {clk100}]
set_property IOSTANDARD LVCMOS18 [get_ports {clk100}]
set_property PACKAGE_PIN AJ14 [get_ports {cpu_resetn}]
set_property IOSTANDARD LVCMOS18 [get_ports {cpu_resetn}]
set_property PACKAGE_PIN AD9 [get_ports {user_led[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[0]}]
set_property PACKAGE_PIN AD8 [get_ports {user_led[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[1]}]
set_property PACKAGE_PIN AE8 [get_ports {user_led[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[2]}]
set_property PACKAGE_PIN AF8 [get_ports {user_led[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[3]}]
set_property PACKAGE_PIN AD10 [get_ports {user_led[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[4]}]
set_property PACKAGE_PIN AN11 [get_ports {serial_tx}]
set_property IOSTANDARD LVCMOS33 [get_ports {serial_tx}]
set_property PACKAGE_PIN AM11 [get_ports {serial_rx}]
set_property IOSTANDARD LVCMOS33 [get_ports {serial_rx}]
set_property PULLTYPE PULLUP [get_ports cpu_resetn]
create_clock -name clk100 -period 10.000 [get_ports clk100]
# Asynchronous serial input is synchronized by the UART RX synchronizer.
set_false_path -from [get_ports serial_rx]
set_false_path -from [get_ports cpu_resetn]
# UART output and status LEDs have no external synchronous capture clock.
set_false_path -to [get_ports {serial_tx user_led[*]}]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 85.0 [current_design]
set_property BITSTREAM.CONFIG.SPI_FALL_EDGE YES [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property CONFIG_VOLTAGE 1.8 [current_design]
set_property CFGBVS GND [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLDOWN [current_design]
