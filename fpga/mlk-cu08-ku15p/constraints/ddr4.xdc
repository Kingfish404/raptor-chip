set_property IOSTANDARD LVCMOS12 [get_ports {ddram_reset_n}]
# MIG's scoped XDC creates the 100 MHz reference clock on clk100_ddr_p.
# Re-declaring it here would override MIG's clock and produce a critical warning.
# The AXI converter contains vendor async FIFOs between these clock families.
set ddr_ref [get_clocks -quiet -of_objects [get_ports clk100_ddr_p]]
set_clock_groups -asynchronous -group [get_clocks -include_generated_clocks clk100] -group [get_clocks -include_generated_clocks $ddr_ref]
# Device reset has pulse-duration requirements, not a synchronous data capture.
set_false_path -to [get_ports ddram_reset_n]
