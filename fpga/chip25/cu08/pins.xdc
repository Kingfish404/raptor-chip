# Existing CU08 board oscillator/reset/UART and FMC_C contact assignments.
# Hold an attached physical chip in reset. Emulated I/O uses its released
# serial-data/DIAG contacts, never its push-pull TDO/CK/CS outputs.
set_property -dict {PACKAGE_PIN P26 IOSTANDARD LVCMOS18} [get_ports clk100]
set_property -dict {PACKAGE_PIN AJ14 IOSTANDARD LVCMOS18} [get_ports cpu_resetn]
set_property -dict {PACKAGE_PIN AM11 IOSTANDARD LVCMOS33} [get_ports serial_rx]
set_property -dict {PACKAGE_PIN AN11 IOSTANDARD LVCMOS33} [get_ports serial_tx]
set_property -dict {PACKAGE_PIN F18 IOSTANDARD LVCMOS18} [get_ports pad_clk]
set_property -dict {PACKAGE_PIN F17 IOSTANDARD LVCMOS18} [get_ports pad_reset_n]
set_property -dict {PACKAGE_PIN B12 IOSTANDARD LVCMOS18} [get_ports uart0_rx]
set_property -dict {PACKAGE_PIN A19 IOSTANDARD LVCMOS18} [get_ports uart0_tx]
set_property -dict {PACKAGE_PIN D15 IOSTANDARD LVCMOS18} [get_ports jtag_tck]
set_property -dict {PACKAGE_PIN E15 IOSTANDARD LVCMOS18} [get_ports jtag_tms]
set_property -dict {PACKAGE_PIN L18 IOSTANDARD LVCMOS18} [get_ports jtag_tdi]
set_property -dict {PACKAGE_PIN C14 IOSTANDARD LVCMOS18} [get_ports jtag_tdo]
set_property -dict {PACKAGE_PIN B16 IOSTANDARD LVCMOS18} [get_ports {gpio[0]}]
set_property -dict {PACKAGE_PIN B17 IOSTANDARD LVCMOS18} [get_ports {gpio[1]}]
set_property -dict {PACKAGE_PIN A18 IOSTANDARD LVCMOS18} [get_ports {gpio[2]}]
set_property -dict {PACKAGE_PIN AD9 IOSTANDARD LVCMOS33} [get_ports {user_led[0]}]
set_property -dict {PACKAGE_PIN AD8 IOSTANDARD LVCMOS33} [get_ports {user_led[1]}]
set_property -dict {PACKAGE_PIN AE8 IOSTANDARD LVCMOS33} [get_ports {user_led[2]}]
set_property -dict {PACKAGE_PIN AF8 IOSTANDARD LVCMOS33} [get_ports {user_led[3]}]
set_property -dict {PACKAGE_PIN AD10 IOSTANDARD LVCMOS33} [get_ports {user_led[4]}]
set_property PULLTYPE PULLUP [get_ports {cpu_resetn uart0_rx jtag_tms jtag_tdi}]
set_property PULLTYPE PULLDOWN [get_ports jtag_tck]
set_property DRIVE 8 [get_ports -filter {DIRECTION != IN}]
set_property SLEW SLOW [get_ports -filter {DIRECTION != IN}]
create_clock -name ref100 -period 10 [get_ports clk100]
set_property CONFIG_VOLTAGE 1.8 [current_design]
set_property CFGBVS GND [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLDOWN [current_design]
