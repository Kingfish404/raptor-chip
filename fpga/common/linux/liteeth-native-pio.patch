+/* The native peripheral window accepts aligned 32-bit accesses only. */
+static void liteeth_read_packet(void *destination, const void __iomem *source, unsigned int len)
+{
+	u8 *out = destination;
+
+	while (len >= 4) {
+		put_unaligned_le32(readl(source), out);
+		source += 4;
+		out += 4;
+		len -= 4;
+	}
+	if (len) {
+		u32 tail = readl(source);
+
+		while (len--) {
+			*out++ = tail;
+			tail >>= 8;
+		}
+	}
+}
+
+static void liteeth_write_packet(void __iomem *destination, const void *source, unsigned int len)
+{
+	const u8 *in = source;
+
+	while (len >= 4) {
+		writel(get_unaligned_le32(in), destination);
+		destination += 4;
+		in += 4;
+		len -= 4;
+	}
+	if (len) {
+		u32 tail = 0;
+		unsigned int i;
+
+		for (i = 0; i < len; i++)
+			tail |= (u32)in[i] << (8 * i);
+		writel(tail, destination);
+	}
+}
