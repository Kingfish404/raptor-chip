# Overlay on the pinned upstream RISC-V defconfig. Native NFS boot needs no
# initramfs, DMA or storage controller. Retain VirtIO for software-only QEMU tests.
CONFIG_RAPTOR_NATIVE_ETH=y
CONFIG_REALTEK_PHY=y
CONFIG_MDIO_BITBANG=y
CONFIG_PHYLIB=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX98_PTYS=y
# Kconfig exposes the virtual-terminal switch only with EXPERT enabled.
CONFIG_EXPERT=y
CONFIG_TTY=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MMIO=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set
# CONFIG_MODULES is not set
# CONFIG_SMP is not set
# Limit scheduler tick overhead on the single 50 MHz FPGA core.
CONFIG_HZ_100=y
# CONFIG_HZ_250 is not set
CONFIG_HZ=100
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_PCI is not set
# CONFIG_MTD is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_MMC is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# The native board has a serial console and an NFS root. Virtual terminals
# select input support again, and unused loop devices add slow udev coldplug
# work. Keep UNIX98 PTYs for SSH and the 8250 UART console above.
# CONFIG_VT is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_PM_DEVFREQ is not set
# CONFIG_WATCHDOG is not set
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_MACB is not set
# CONFIG_E1000E is not set
# CONFIG_R8169 is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_MICREL_PHY is not set
# CONFIG_MICROSEMI_PHY is not set
# CONFIG_MOTORCOMM_PHY is not set
# CONFIG_PROFILING is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_DEBUG_INFO is not set
# Measured on the native small preset: these unused initializers dominate boot.
# getrandom uses fresh /chosen/rng-seed; crypto DRBG is unnecessary for this image.
# CONFIG_LEGACY_PTYS is not set
# CONFIG_BLK_DEV_THROTTLING is not set
# CONFIG_CRYPTO_DRBG_MENU is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=1
# IPsec IV generators select the crypto DRBG/jitter entropy dependency again.
# This NFS/SSH image uses kernel getrandom plus fresh boot entropy, and keeps
# userspace TLS/SSH crypto; IPsec ESP is outside this board image's feature set.
# CONFIG_XFRM_USER is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET6_ESP is not set
# CONFIG_CRYPTO_GENIV is not set
# CONFIG_CRYPTO_SEQIV is not set
# CONFIG_CRYPTO_ECHAINIV is not set
# CONFIG_CRYPTO_RNG_DEFAULT is not set
# CONFIG_CRYPTO_DRBG is not set
# Trace-event format expansion runs in an init workqueue and dominated later
# boots at trace_eval_sync. Keep normal logs, stack traces and SysRq diagnostics.
# CONFIG_FTRACE is not set
