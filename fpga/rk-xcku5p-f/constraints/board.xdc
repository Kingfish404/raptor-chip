# RK-XCKU5P-F V1.2 board pins (fan G9, active high).
set_property PACKAGE_PIN T24 [get_ports {sys_clk_p}]
set_property IOSTANDARD DIFF_SSTL12 [get_ports {sys_clk_p}]
set_property PACKAGE_PIN U24 [get_ports {sys_clk_n}]
set_property IOSTANDARD DIFF_SSTL12 [get_ports {sys_clk_n}]
set_property PACKAGE_PIN K9 [get_ports {cpu_resetn}]
set_property IOSTANDARD LVCMOS33 [get_ports {cpu_resetn}]
set_property PACKAGE_PIN AD13 [get_ports {serial_rx}]
set_property IOSTANDARD LVCMOS33 [get_ports {serial_rx}]
set_property PACKAGE_PIN AC14 [get_ports {serial_tx}]
set_property IOSTANDARD LVCMOS33 [get_ports {serial_tx}]
set_property PACKAGE_PIN G9 [get_ports {fan_enable}]
set_property IOSTANDARD LVCMOS33 [get_ports {fan_enable}]
set_property PACKAGE_PIN H9 [get_ports {user_led[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[0]}]
set_property PACKAGE_PIN J9 [get_ports {user_led[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[1]}]
set_property PACKAGE_PIN G11 [get_ports {user_led[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[2]}]
set_property PACKAGE_PIN H11 [get_ports {user_led[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_led[3]}]
set_property DRIVE 8 [get_ports {user_led[*] fan_enable}]
set_property PULLTYPE PULLUP [get_ports cpu_resetn]
create_clock -name sys_clk -period 5.000 [get_ports sys_clk_p]
set_false_path -from [get_ports {serial_rx cpu_resetn}]
set_false_path -to [get_ports {serial_tx user_led[*] fan_enable}]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 51.0 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property CONFIG_VOLTAGE 1.8 [current_design]
set_property CFGBVS GND [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLUP [current_design]
