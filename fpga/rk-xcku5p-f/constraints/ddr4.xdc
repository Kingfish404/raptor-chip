# The clock-domain exception is installed by create_ip.tcl after IP linking.
set_false_path -to [get_ports ddram_reset_n]
# DCI lock is asynchronous and is captured by dci_ready's two-stage synchronizer.
set_false_path -through [get_pins ddr_subsystem/dci_reset/LOCKED]
