# ==============================================================================
# Strategy: deny-all + whitelist.
# All files ignored by default; directories allowed for traversal.
# Self-contained subdirs (nemu, sim, abstract-machine, fpga/)
# have their own deny-all .gitignore.
# Non-self-contained subdirs are whitelisted below.
# ==============================================================================

# Ignore all files, allow directory traversal
*
!*/

# ---- Root-level files ----
!.gitignore
!.clangd
!Makefile
!README.md
!raptor-chip.code-workspace
!env.sh
!setup.sh
!setup-rtl.sh
!LICENSE
!NOTICE

# ---- GitHub CI/CD ----
!/.github/**
/.github/*.md

# ---- HDL sources (global whitelist for hdl/) ----
!*.v
!*.vh
!*.sv
!*.svh

# ---- LiteX upstream source patches ----
!/fpga/litex/benchmarks/embench/patches/*.patch

# ---- Non-self-contained directories (need root whitelist) ----
!/docs/*
!/linux/*
!/hdl/**
!/verify/*

# ---- Re-ignore: generated, third-party, synthesis, local config ----
/hdl/generated/
/hdl/chisel/target/
/third_party/
/docs-*/
/syn/
Makefile.local

# ---- OS artifacts ----
.DS_Store
