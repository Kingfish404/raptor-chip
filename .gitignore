# ==============================================================================
# Strategy: deny-all + whitelist.
# All files ignored by default; directories allowed for traversal.
# Self-contained subdirs (nemu, nsim, abstract-machine, fpga/)
# have their own deny-all .gitignore.
# Non-self-contained subdirs are whitelisted below.
# ==============================================================================

# Ignore all files, allow directory traversal
*
!*/

# ---- Root-level files ----
!.gitignore
!Makefile
!README.md
!env.sh
!setup.sh
!setup-rtl.sh
!LICENSE
!NOTICE

# ---- GitHub CI/CD ----
!/.github/**
/.github/*.md

# ---- HDL sources (global whitelist for rtl_sv/) ----
!*.v
!*.vh
!*.sv
!*.svh

# ---- Non-self-contained directories (need root whitelist) ----
!/docs/*
!/linux/*
!/rtl_scala/*
!/rtl_sv/*
!/verify/*

# ---- Re-ignore: generated, third-party, synthesis, local config ----
/rtl_sv/generated/
/rtl_scala/target/
/third_party/
/docs-*/
/syn/
Makefile.local

# ---- OS artifacts ----
.DS_Store
