#!/usr/bin/env python3
"""Check the proposed public commit message."""
import os
from pathlib import Path
import sys

if len(sys.argv) != 2:
    sys.exit("public-tree: error: commit-msg requires a message file")
checker = Path(__file__).resolve().parents[1] / "check_public_tree.py"
os.execv(sys.executable, [sys.executable, str(checker), "--commit-message=" + sys.argv[1]])
